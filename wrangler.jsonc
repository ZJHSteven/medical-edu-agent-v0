{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "medical-edu-agent-demo",

  // Browser Run 继续作为可选网页读取能力。Free 计划有日额度，
  // 因而不会拿它替代普通 Web Search，只在渲染页面/抽取结构时使用。
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },

  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "not_found_handling": "single-page-application",
    // 认证与 Agent WebSocket/RPC 必须先进入 Worker；其余页面由 SPA assets 返回。
    "run_worker_first": ["/auth/*", "/chat", "/chat/*", "/api/*"]
  },

  "durable_objects": {
    "bindings": [
      {
        "class_name": "AssistantDirectory",
        "name": "AssistantDirectory"
      },
      {
        "class_name": "ProviderStatus",
        "name": "ProviderStatus"
      }
    ]
  },

  "main": "src/server.ts",

  "migrations": [
    {
      "new_sqlite_classes": ["AssistantDirectory"],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": ["ProviderStatus"],
      "tag": "v2"
    }
  ]
}
