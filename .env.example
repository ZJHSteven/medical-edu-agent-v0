# Family AI V0 local environment template.
# Copy to .env.local for local development. Never commit real secrets.

# Family account authentication/session signing.
AUTH_SECRET=

# Heyiwei model API keys, one canonical key per group.
HEYIWEI_G2_KEY=
HEYIWEI_G9_KEY=
HEYIWEI_G13_KEY=
HEYIWEI_G35_KEY=
HEYIWEI_G39_KEY=
HEYIWEI_G42_KEY=

# Heyiwei web-console refresh token.
# ProviderStatus uses it only as the bootstrap token; when Heyiwei rotates the
# refresh token, the latest value is persisted inside the ProviderStatus DO.
HEYIWEI_CONSOLE_REFRESH_TOKEN=

# Seal Cloud / Haibao routes.
HAIBAO_G2_KEY=
HAIBAO_G19_KEY=

# DeepSeek official API.
DEEPSEEK_API_KEY=

# Optional local-dev user shortcut when auth.ts enables it.
# Never set this in production.
# DEV_USER=yourname
