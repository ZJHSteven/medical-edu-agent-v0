{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "medical-edu-pi-remote-bench",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "durable_objects": {
    "bindings": [
      { "name": "PiBenchAgent", "class_name": "PiBenchAgent" },
      { "name": "PiBenchDirectory", "class_name": "PiBenchDirectory" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PiBenchAgent", "PiBenchDirectory"]
    }
  ]
}
